/* 김자까의 기록 — 공용 스타일 (시안 1014, 라이트 고정) */
:root{
  --bg:#ffffff;--paper:#faf8f4;--ink:#333333;--body:#333333;--sub:#6b665f;--cap:#8f8a83;--meta:#b3aea7;--line:#e6e2db;
  /* 브런치 실측(10-14, @elissakicks/30): 본문 Noto Sans CJK Light(="DemiLight" 이름) 14.67/29.33 +0.8px #333 · 제목 나눔명조 R 45.33/53.33 · 소제 Light 18.67/28.67 · 인용 Light 20/30.67 · 캡션 13.33 #909090 · 메타 12 #bbb */
  --band:#cbd2c4;--band-ink:#1f2620;
  --pick:#e0892f; /* 그래프·픽 테두리용 오렌지 유지. 인용 강조선만 무채색(10-14) */--boss:#222222;
  --col:700px;
  --ease:cubic-bezier(.2,.7,.2,1);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--body);
  font-family:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic",sans-serif;font-weight:300;
  font-size:14.67px;line-height:2;letter-spacing:.8px;word-break:keep-all;overflow-wrap:anywhere}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}

/* 상단 바 — 60px 고정, 커버를 지나면 종이색 반투명 */
.gnb{position:fixed;top:0;left:0;right:0;height:60px;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:0 24px;
  color:var(--ink);background:rgba(255,255,255,0);transition:background .3s var(--ease),color .3s var(--ease),box-shadow .3s var(--ease)}
.gnb.on{background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);box-shadow:0 1px 0 var(--line)}
.gnb.light{color:#fff}
.gnb.light.on{color:var(--ink)}
.gnb .l,.gnb .r{display:flex;align-items:center;gap:22px;font-size:13.5px;font-weight:500;letter-spacing:-.01em}
.gnb .mk{font-weight:700;font-size:15px;letter-spacing:-.02em}
.gnb .mag{display:inline-flex;align-items:center;gap:8px;font-weight:400;opacity:.85}
.gnb .mag i{font-style:normal;font-size:11px;border:1px solid currentColor;border-radius:999px;padding:1px 7px;opacity:.8}
.gnb .r a{opacity:.75;transition:opacity .15s}.gnb .r a:hover{opacity:1}
.left{font-size:12px;font-weight:400;letter-spacing:0;font-variant-numeric:tabular-nums;opacity:0;transition:opacity .25s}.gnb.on .left{opacity:.55} /* 브런치식 상단 진행바 대신 남은 시간(10-14) */

/* 홈 밴드 — 브런치 틸 자리에 피그마 세이지 */
.band{background:var(--band);color:var(--band-ink);padding:124px 24px 56px}
.band .in{max-width:var(--col);margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end}
.band h1{font-family:"Nanum Myeongjo","AppleMyungjo",serif;font-size:36px;font-weight:400;letter-spacing:-.01em;line-height:1.25;margin:0 0 8px}
.band .by{font-size:14px;margin:0 0 20px;opacity:.8}
.band .chips{display:flex;gap:8px;flex-wrap:wrap;margin:0;padding:0;list-style:none}
.band .chips li{font-size:12.5px;background:rgba(255,255,255,.45);border-radius:999px;padding:5px 12px}
.band .fig{width:176px;height:176px;margin:0 0 -64px;filter:drop-shadow(0 6px 10px rgba(0,0,0,.08))}
.band .fig img{width:100%;height:100%;object-fit:contain;object-position:bottom}

/* 홈 목록 */
.home{max-width:var(--col);margin:0 auto;padding:40px 24px 120px}
.home .lead{font-size:14.67px;color:var(--sub);margin:0 0 28px;line-height:1.9}
.home .bar{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--sub);border-bottom:1px solid var(--line);padding:0 0 12px;margin:0 0 4px}
.home .bar b{color:var(--ink);font-weight:500}
ul.list{list-style:none;margin:0;padding:0}
ul.list li{border-bottom:1px solid var(--line)}
ul.list a{display:grid;grid-template-columns:1fr 104px;gap:28px;align-items:start;padding:26px 0;transition:opacity .15s}
ul.list a:hover{opacity:.72}
ul.list h2{font-size:20px;font-weight:500;letter-spacing:-.02em;line-height:1.45;margin:0 0 8px;color:var(--ink)}
ul.list .ex{font-size:14.67px;line-height:1.75;color:var(--sub);margin:0 0 10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
ul.list .ex b{font-weight:500;color:var(--body)}
ul.list .d{font-size:12px;color:var(--meta);letter-spacing:-.05em;margin:0}
ul.list .th{width:104px;height:104px;border-radius:6px;overflow:hidden;background:var(--paper)}
ul.list .th img{width:100%;height:100%;object-fit:cover}
ul.list li.ex-row{opacity:.42}
ul.list li.ex-row .th{border:1px dashed var(--line);background:transparent}
.home .more{display:block;margin:40px 0 0;text-align:center;font-size:13.5px;color:var(--sub)}

/* 작가 카드(홈·글 공용) */
.author{max-width:var(--col);margin:0 auto;padding:0 24px}
.author .box{display:grid;grid-template-columns:72px 1fr auto;gap:20px;align-items:center;background:var(--paper);border-radius:12px;padding:22px 24px}
.author .av{width:72px;height:72px;border-radius:50%;background:#f2e7cf;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}
.author .av img{width:100%;height:100%;object-fit:contain;transform:scale(1.25);transform-origin:50% 100%}
.author h3{margin:0 0 4px;font-size:16px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.author p{margin:0;font-size:13.5px;color:var(--sub);line-height:1.7}
.author .go{font-size:13px;font-weight:500;color:var(--ink);border:1px solid var(--ink);border-radius:999px;padding:8px 14px;white-space:nowrap;transition:background .15s,color .15s}
.author .go:hover{background:var(--ink);color:#fff}

/* 글 — 커버 2종 */
.cover{position:relative;height:450px;display:flex;align-items:flex-end}
.cover .in{position:relative;width:100%;max-width:var(--col);margin:0 auto;padding:0 24px 40px}
.cover h1{font-family:"Nanum Myeongjo","AppleMyungjo",serif;font-weight:400;font-size:45.33px;line-height:1.18;letter-spacing:-.01em;margin:0 0 12px;color:var(--ink)}
.cover .sub{font-size:16px;color:var(--sub);margin:0 0 20px;line-height:1.5;letter-spacing:-.03em}
.cover .meta{font-size:12px;color:var(--meta);letter-spacing:-.05em;margin:0;display:flex;gap:10px;flex-wrap:wrap}
.cover .meta b{font-weight:400;color:var(--sub)}
.cover.full{height:100vh;height:100svh;min-height:560px;color:#fff}
.cover.full .bgw{position:fixed;top:0;left:0;right:0;height:100vh;height:100svh;z-index:0;overflow:hidden}
.cover.full .bg{width:100%;height:100%;object-fit:cover;object-position:center 30%}
.cover.full .bgw:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.18) 0%,rgba(0,0,0,.08) 45%,rgba(0,0,0,.62) 100%)}
.cover.full .in{z-index:1;padding-bottom:56px}
.cover.full h1,.cover.full .sub,.cover.full .meta,.cover.full .meta b{color:#fff}
.cover.full .sub{opacity:.85}.cover.full .meta{opacity:.8}
.cover.full .down{position:absolute;right:24px;bottom:56px;font-size:12px;letter-spacing:.1em;opacity:.8}
.cover.text{background:#fff;border-bottom:1px solid var(--line)}

/* 커버 B(미지, 오른쪽 위) — 제목은 왼쪽 가장자리, 좌하단 사선 그라데이션, 얼굴은 건드리지 않음 */
.cover.full.coverb .bg{object-position:center 40%}
.cover.full.coverb .bgw:after{background:linear-gradient(to top right,rgba(30,35,70,.62) 0%,rgba(30,35,70,.38) 28%,rgba(30,35,70,.12) 48%,rgba(30,35,70,0) 62%)}
.cover.full.coverb .in{max-width:none;padding:0 64px 60px}
.cover.full.coverb h1,.cover.full.coverb .sub,.cover.full.coverb .meta{max-width:620px;text-shadow:0 1px 2px rgba(20,24,50,.25)}

/* 글 본문 — 700px · 브런치 실측대로 Light 14.67 / 29.33 / +0.8px */
.article{position:relative;z-index:1;background:var(--bg)}
.wrap{max-width:var(--col);margin:0 auto;padding:56px 24px 72px}
.wrap p{margin:0 0 24px;font-size:14.67px;line-height:2;letter-spacing:.8px}
.wrap b,.wrap strong{font-weight:700}
.wrap .chap{text-align:center;margin:96px 0 48px}
.wrap .chap .no{display:block;font-size:12px;font-weight:400;letter-spacing:.32em;color:var(--cap);margin:0 0 16px;padding-left:.32em}
.wrap .chap h2{font-weight:300;font-size:18.67px;line-height:1.54;letter-spacing:.8px;margin:0;color:var(--ink)}
.wrap .chap .rule{display:block;width:28px;height:1px;background:var(--ink);margin:24px auto 0;opacity:.5}
.wrap .chap.appx{margin:72px 0 28px}
.wrap .chap.appx .end{display:block;font-size:13.33px;font-weight:400;letter-spacing:.2em;color:var(--cap);margin-bottom:88px}
.wrap .chap.appx .no{border-top:1px solid var(--line);padding-top:40px}
.wrap .chap.appx h2{font-size:16px;color:var(--sub)}
.wrap p.say{font-size:16px;font-weight:400;line-height:1.75;margin:26px 0;padding-left:16px;border-left:2px solid #cfcac2;color:var(--ink);letter-spacing:.4px} /* 10-14 강조 축소: 20→16, 선 3px 오렌지→2px 옅은 회색 */
.wrap blockquote{margin:26px 0;padding:0 0 0 16px;border-left:2px solid #cfcac2;font-size:16px;font-weight:400;line-height:1.75;letter-spacing:.4px}
.wrap blockquote.long{font-family:inherit;font-size:14.67px;line-height:2;color:var(--body);border:0;padding:0 0 0 1.5em;margin:26px 0}
.wrap blockquote cite{display:block;font-style:normal;font-size:13.33px;color:var(--cap);margin-top:6px;letter-spacing:0}
.wrap hr{border:0;border-top:1px solid var(--line);margin:40px 0}
.wrap figure{margin:34px 0}
.wrap figure .row{display:grid;gap:8px}
.wrap figure .row.n1{grid-template-columns:1fr}.wrap figure .row.n2{grid-template-columns:1fr 1fr}
.wrap figure .row.n3{grid-template-columns:repeat(3,1fr)}.wrap figure .row.n4{grid-template-columns:repeat(4,1fr)}
.wrap figure .cell{margin:0}
.wrap figure img{width:100%;height:auto;border-radius:6px;border:3px solid transparent}
.wrap figure .cell.pick img{border-color:var(--pick)}.wrap figure .cell.boss img{border-color:var(--boss)}
.wrap figure .lab{font-size:13.33px;color:var(--cap);line-height:1.55;margin-top:6px;letter-spacing:0}
.wrap figure .cell.pick .lab{color:var(--pick);font-weight:400}.wrap figure .cell.boss .lab{color:var(--ink);font-weight:700}
.wrap figcaption{font-size:13.33px;color:var(--cap);line-height:1.55;margin:12px 0 0;text-align:center;letter-spacing:0}
.wrap .bars{margin:26px 0 6px}
.wrap .bar{display:grid;grid-template-columns:5.5em 1fr 4.5em;align-items:center;gap:10px;margin:8px 0;font-size:13.33px;letter-spacing:0}
.wrap .bar .who{color:var(--sub)}.wrap .bar .fill{display:block;height:14px;border-radius:3px;min-width:3px}
.wrap .bar .fill.pick{background:var(--pick)}.wrap .bar .fill.boss{background:var(--boss)}.wrap .bar .n{font-weight:700;text-align:right}
.wrap p.cap{font-size:13.33px;color:var(--cap);text-align:center;margin:-2px 0 24px;letter-spacing:0;line-height:1.55}
.wrap .foot{color:var(--cap);font-size:13.33px;font-style:normal}

/* 정말 강조할 것만 명조 — 글마다 한두 곳 */
.em-serif,.wrap p.say.em-serif{font-family:"Nanum Myeongjo","AppleMyungjo",serif;font-weight:400;font-size:18px;letter-spacing:-.01em;line-height:1.6} /* 10-14 22→18 */

/* 글 끝 흐름: 키워드 → 마무리 → 작가 → 다음 글 */
.end{max-width:var(--col);margin:0 auto;padding:0 24px 96px}
.end .kw{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 56px;padding:0;list-style:none}
.end .kw li{font-size:12.5px;color:var(--cap);letter-spacing:0;border:1px solid var(--line);border-radius:999px;padding:5px 12px}
.end .fin{font-size:18.67px;font-weight:300;line-height:1.54;color:var(--ink);margin:0 0 20px;letter-spacing:.8px}
.end .acts{display:flex;gap:14px;align-items:center;margin:0 0 56px;font-size:13.5px;color:var(--sub)}
.end .acts a{border:1px solid var(--line);border-radius:999px;padding:7px 14px;transition:border-color .15s}
.end .acts a:hover{border-color:var(--ink);color:var(--ink)}
.end .author{padding:0;margin:0 0 56px}
.end .next h4{font-size:13px;color:var(--sub);font-weight:500;margin:0 0 14px;letter-spacing:.02em}
.end .next .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.end .next .card{display:block}
.end .next .card .im{aspect-ratio:4/3;border-radius:6px;background:var(--paper);overflow:hidden;margin:0 0 10px}
.end .next .card .im img{width:100%;height:100%;object-fit:cover}
.end .next .card b{display:block;font-size:14.67px;font-weight:500;letter-spacing:-.01em;color:var(--ink);line-height:1.5;letter-spacing:-.01em}
.end .next .card span{display:block;font-size:12px;color:var(--meta);margin-top:3px;letter-spacing:-.05em}
.end .next .card.ph{opacity:.42}
.end .next .card.ph .im{border:1px dashed var(--line);background:transparent}

footer.site{border-top:1px solid var(--line);padding:28px 24px;font-size:12.5px;color:var(--sub);display:flex;justify-content:space-between;gap:12px;max-width:var(--col);margin:0 auto}

@media (max-width:640px){
  body{font-size:15px}
  .gnb{padding:0 16px}.gnb .r{gap:14px;font-size:13px}.gnb .mag span{display:none}
  .band{padding:100px 20px 44px}.band .in{grid-template-columns:1fr auto;gap:12px}
  .band h1{font-size:28px}.band .fig{width:112px;height:112px;margin-bottom:-50px}
  .home{padding:28px 20px 80px}
  ul.list a{grid-template-columns:1fr 84px;gap:16px;padding:22px 0}
  ul.list h2{font-size:18px}ul.list .th{width:84px;height:84px}
  .author .box{grid-template-columns:56px 1fr;padding:18px}.author .av{width:56px;height:56px}.author .go{grid-column:2}
  .cover{height:auto;padding-top:60px}.cover .in{padding:36px 20px 28px}
  .cover h1{font-size:28px;line-height:1.3}.cover .sub{font-size:15px}
  .cover.full{height:100svh;min-height:520px;padding-top:0}.cover.full .in{padding-bottom:48px}
  .cover.full .down{display:none}
  .cover.full .bg{object-position:center 10%}
  .cover.full.coverb .bg{object-position:86% center}
  .cover.full.coverb .bgw:after{background:linear-gradient(to top,rgba(30,35,70,.66) 0%,rgba(30,35,70,.42) 28%,rgba(30,35,70,.08) 52%,rgba(30,35,70,0) 64%)}
  .cover.full.coverb .in{padding:0 20px 44px}
  .wrap{padding:40px 20px 56px}
  .wrap p{font-size:15px;line-height:1.9;letter-spacing:.5px}
  .wrap .chap{margin:76px 0 40px}.wrap .chap h2{font-size:18px}
  .wrap p.say,.wrap blockquote{font-size:15.5px}
  .em-serif,.wrap p.say.em-serif{font-size:17px}
  .wrap figure .row.n3,.wrap figure .row.n4{grid-template-columns:1fr 1fr}
  .end{padding:0 20px 72px}.end .next .grid{grid-template-columns:1fr 1fr}
  footer.site{flex-direction:column;gap:4px}
}
@media (prefers-reduced-motion:reduce){
  .gnb{transition:none}
  .cover.full .bgw{position:absolute}
}
